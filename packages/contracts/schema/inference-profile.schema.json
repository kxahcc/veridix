{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veridix.local/schemas/inference-profile.schema.json",
  "title": "InferenceProfile",
  "type": "object",
  "required": ["providerId", "model", "endpoint", "dataPolicy", "timeoutSeconds"],
  "properties": {
    "providerId": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "string", "minLength": 1 },
    "apiKeyRef": { "type": "string", "minLength": 1 },
    "dataPolicy": { "enum": ["local", "project_remote_allowed", "remote"] },
    "timeoutSeconds": { "type": "integer", "minimum": 1 },
    "maxContextTokens": { "type": "integer", "minimum": 1 },
    "capabilities": {
      "type": "object",
      "properties": {
        "toolCalling": { "type": "boolean" },
        "streaming": { "type": "boolean" }
      }
    },
    "requestOptions": {
      "type": "object",
      "properties": {
        "thinkingMode": {
          "type": "string",
          "enum": ["enabled", "disabled"]
        },
        "toolChoice": {
          "type": "string",
          "enum": ["auto", "none", "required"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
