      "description": "Run a two-context authorization matrix cell over real HTTP",
      "schema": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "Full URL path being tested, for example /admin"
          },
          "method": {
            "type": "string",
            "description": "HTTP method, defaults to GET"
          },
          "low_privilege_token": {
            "type": "string",
            "description": "Bearer token for the low-privilege context"
          },
          "high_privilege_token": {
            "type": "string",
            "description": "Bearer token for the high-privilege context"
          },
          "object_id": {
            "type": "string",
            "description": "Object identifier when the matrix cell is object-scoped"
          }
        },
        "required": [
          "endpoint",
          "low_privilege_token",
          "high_privilege_token"
        ],
        "additionalProperties": false
      },
      "risk_level": "L2",
      "runner": "native",
      "sandbox_profile": "S2",
      "examples": [
        "web.authz.test endpoint=/admin method=GET low_privilege_token=user-token high_privilege_token=admin-token object_id=user_1"
      ]
