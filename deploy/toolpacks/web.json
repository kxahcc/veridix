            "type": "string",
            "default": "200,204,301,302,307,401,403"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "risk_level": "L2",
      "runner": "container",
      "sandbox_profile": "S2",
      "timeout_seconds": 300,
      "output_parser": "ffuf_jsonl",
      "command_template": [
        "ffuf",
        "-w",
        "{wordlist}",
        "-u",
        "{url}",
        "-mc",
        "{status_codes}",
        "-of",
        "json"
      ],
      "examples": [
