# Veridix environment reference
# All variables are optional. The values below are the defaults used when
# the corresponding variable is absent, unless a different default is
# already hard-coded by the service.

# --- Runtime and ports ---
VERIDIX_RUNTIME_DIR=runtime
VERIDIX_CONTROL_PORT=8787
VERIDIX_AGENT_PORT=8788
VERIDIX_WEB_PORT=5173
VERIDIX_LAB_PORT=8766
VERIDIX_WORKER_MAX_TURNS=50
VERIDIX_WORKER_MAX_TOKENS=1024
VERIDIX_WORKER_POLL_INTERVAL=1
VERIDIX_WORKER_SPOOL_LIMIT=1000
VERIDIX_WORKER_AUTOPILOT=1

# --- Provider (usually configured from Web/TUI, kept as optional fallback) ---
# VERIDIX_PROVIDER_ENDPOINT=https://api.deepseek.com/v1
# VERIDIX_PROVIDER_MODEL=deepseek-v4-flash
# VERIDIX_PROVIDER_API_KEY_REF=env:DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=

# --- Runner ---
# fake is best for demo; docker is required for real security tools
VERIDIX_RUNNER=fake
VERIDIX_DOCKER_IMAGE=ghcr.io/kxahcc/veridix/veridix-tools:full
VERIDIX_TOOL_NETWORK=veridix-system_veridix-net

# --- Storage / retrieval ---
VERIDIX_STORAGE_PROFILE=desktop
VERIDIX_STORAGE_AUTOPROVISION=1
VERIDIX_STORAGE_REGISTRY=docker.m.daocloud.io/
VERIDIX_VECTOR_BACKEND=sqlite
VERIDIX_PGVECTOR_PORT=55432
# VERIDIX_PGVECTOR_URL=postgresql://veridix:veridix@127.0.0.1:55432/veridix
VERIDIX_QDRANT_URL=http://127.0.0.1:6333
VERIDIX_CHROMA_URL=http://127.0.0.1:8001
VERIDIX_NEO4J_URI=bolt://127.0.0.1:7687
VERIDIX_NEO4J_USER=neo4j
VERIDIX_NEO4J_PASSWORD=veridixpass
VERIDIX_EMBEDDING_ENDPOINT=http://127.0.0.1:11434/v1
VERIDIX_EMBEDDING_MODEL=nomic-embed-text
VERIDIX_EMBEDDING_KEEP_ALIVE=5m
VERIDIX_RERANK_ENABLED=1
VERIDIX_RERANK_BACKEND=fastembed
VERIDIX_RERANK_MODEL=BAAI/bge-reranker-base
VERIDIX_RETRIEVAL_FUSION=rrf
VERIDIX_RETRIEVAL_DEADLINE=8

# --- ZAP DAST ---
VERIDIX_ZAP_URL=http://127.0.0.1:8090
VERIDIX_ZAP_API_KEY=veridix-zap

# --- Identity (optional; unset means local single-user admin) ---
# VERIDIX_CONTROL_TOKEN=
# VERIDIX_CONTROL_ROLE=admin
# VERIDIX_CONTROL_USERS={"op-token":{"role":"operator","projects":["project_xxx"]}}

# --- Lab provider ---
# LAB_PROVIDER_API_KEY=
# LAB_PROVIDER_SCENARIO=shell

# --- Hugging Face mirrors ---
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
